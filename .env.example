# Use your real Netlify URL/custom domain, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Create this user in Supabase Auth; do not enable public signups.
ADMIN_EMAIL=
# Random secret of at least 32 characters for hashing abuse-prevention keys.
RATE_LIMIT_SECRET=
# Cloudflare Turnstile: required for public forms once deployed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional. Enable payments in owner settings only after connecting Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional Resend delivery. FROM_EMAIL must be a verified sender.
RESEND_API_KEY=
FROM_EMAIL=
OWNER_NOTIFICATION_EMAIL=
